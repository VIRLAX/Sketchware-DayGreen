<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp">
    <ImageView android:id="@+id/severity_icon" android:layout_width="20dp" android:layout_height="20dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/line_number" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/diagnostic_message" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/diagnostic_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
