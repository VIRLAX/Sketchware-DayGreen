<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#F7F8FA"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:cardBackgroundColor="#F7F8FA"
    app:cardCornerRadius="28dp"
    app:cardElevation="22dp"
    app:strokeColor="#D9DEE8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/preview_header"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#FF5F57" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#FEBC2E" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#28C840" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_floating_preview"
                android:tint="#1F2937" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Layout Preview"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="LIVE  •  native interactive"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_live"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_preview_live"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="LIVE"
                android:textColor="#087F5B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/preview_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Minimize preview"
                android:padding="8dp"
                android:src="@drawable/ic_floating_close"
                android:tint="#475569" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/preview_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F1F5F9"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/preview_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F8FAFC"
                android:clipChildren="false"
                android:padding="12dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/preview_log_container"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#111827"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREVIEW LOG"
                android:textColor="#93C5FD"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:fontFamily="monospace"
                android:maxLines="3"
                android:text="Waiting for XML render..."
                android:textColor="#CBD5E1"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drag header  •  edit code outside  •  live sync"
                android:textColor="#64748B"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/preview_resize"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Resize preview"
                android:padding="5dp"
                android:src="@drawable/ic_floating_resize"
                android:tint="#64748B" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
