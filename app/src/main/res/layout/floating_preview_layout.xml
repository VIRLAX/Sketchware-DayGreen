<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#101917"
    app:cardCornerRadius="24dp"
    app:cardElevation="18dp"
    app:strokeColor="#4A8278"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/preview_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#18312D"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_floating_preview" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Layout Preview"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="#E9FFF8" />

                <TextView
                    android:id="@+id/preview_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIVE  •  native interactive"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#9EE8C7" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_live"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_preview_live"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="LIVE"
                android:textColor="#B9F0D7"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/preview_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Minimize preview"
                android:src="@drawable/ic_floating_close" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/preview_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#070B10"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <FrameLayout
                android:id="@+id/preview_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#070B10"
                android:clipChildren="false"
                android:foreground="@drawable/bg_preview_device_stage"
                android:padding="12dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="#0E1D1B"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREVIEW LOGCAT"
                android:textColor="#77CFAE"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:fontFamily="monospace"
                android:maxLines="4"
                android:text="Waiting for XML render..."
                android:textColor="#B7CEC7"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="#18312D"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drag header  •  swipe left to minimize"
                android:textColor="#82AFA3"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/preview_resize"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Resize preview"
                android:padding="5dp"
                android:src="@drawable/ic_floating_resize" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
